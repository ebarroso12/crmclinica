{
  "name": "crmclinica",
  "version": "0.1.0",
  "private": true,
  "description": "CRM clínico da Clínica Dr. Edson Barroso, com atendimento automatizado pela Serena",
  "type": "commonjs",
  "main": "src/index.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "iniciar": "node src/index.js",
    "start": "node src/index.js",
    "criar-admin": "node bin/criar-admin.js",
    "verificar-banco": "node bin/verificar-banco.js",
    "seguranca:segredos": "node bin/verificar-segredos.js",
    "smoke": "node ferramentas/smoke-fluxo.js",
    "smoke-lembretes": "node ferramentas/smoke-lembretes.js",
    "lembretes": "node bin/lembretes.js",
    "lembretes:worker": "node bin/worker-lembretes.js",
    "google:worker": "node bin/worker-google-outbox.js",
    "outbox:worker": "node bin/worker-outbox.js",
    "email:worker": "node bin/worker-email.js",
    "smoke-google": "node ferramentas/smoke-google-sync.js",
    "smoke-instagram": "node ferramentas/smoke-instagram.js",
    "checar-drift": "node ferramentas/checar-drift-configuracao.js",
    "test": "node --test \"testes/**/*.test.js\"",
    "verificar": "node ferramentas/verificar-sintaxe.js",
    "test:pg": "node ferramentas/exigir-banco-de-teste.js",
    "test:voz": "python3 -m unittest discover -s servicos/serena-voz/testes",
    "preparar-conexao": "node bin/preparar-conexao-app.js",
    "parear-openclaw": "node bin/parear-openclaw.js",
    "semear-serena": "node bin/semear-serena.js",
    "semear-instagram": "node bin/semear-instagram.js",
    "semear-agentes": "node bin/semear-agentes.js",
    "verificar-dominio": "node bin/verificar-dominio.js"
  },
  "dependencies": {
    "pg": "^8.22.0"
  }
}
