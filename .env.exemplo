# Modelo de ambiente do crmclinica.
# Copie para .env apenas na máquina local. Nunca versione valores reais.
# Em produção (Vercel), cada valor vive nas variáveis de ambiente do projeto.

# --- Aplicação ---
NODE_ENV=development
PORT=4100
# Teto de bytes aceito no corpo de um evento recebido.
LIMITE_CORPO_BYTES=65536

# --- CRM: fonte de verdade (PostgreSQL/Supabase) ---
# O inbox é o próprio produto: contatos, conversas e mensagens vivem aqui.
# Use sempre a connection string com senha do banco, nunca a chave de serviço no navegador.
#
# Conecte como `crmclinica_app`, NUNCA como `postgres`. A URL tem o formato
# padrão do PostgreSQL, com `crmclinica_app` no lugar do usuário e a senha dela
# — escrita por extenso aqui, a auditoria do `npm test` a trataria como
# credencial versionada, e ela está certa em fazer isso.
#
# `postgres` é dono das tabelas e tem BYPASSRLS — conectando por ele, o Row Level
# Security não é sequer avaliado, e todas as políticas viram decoração.
# `crmclinica_app` não tem SUPERUSER, BYPASSRLS, CREATEROLE nem CREATEDB.
# Defina a senha fora do repositório: ALTER ROLE crmclinica_app WITH PASSWORD '...'
#
# `npm run verificar-banco` avisa quando a conexão é do dono.
CRMCLINICA_DATABASE_URL=
SUPABASE_PROJECT_REF=umvpwqqjzpxwuxdnnxzy
SUPABASE_URL=https://umvpwqqjzpxwuxdnnxzy.supabase.co
# Conexões simultâneas do pool e limite de espera por conexão livre.
CRMCLINICA_DB_POOL_MAX=10
CRMCLINICA_DB_TIMEOUT_MS=10000

# --- OpenClaw: orquestrador de eventos, ferramentas e tarefas ---
OPENCLAW_BASE_URL=https://openclaw.edsonbarrosojr.com.br
OPENCLAW_TOKEN=
OPENCLAW_API_URL=wss://openclaw.edsonbarrosojr.com.br
OPENCLAW_SESSION_ID=

# --- OpenClaw: gateway WebSocket (é por aqui que a mensagem sai) ---
# O envio usa o método `send` do gateway — o mesmo do comando oficial
# `openclaw message send`. Protocolo e evidências em docs/OPENCLAW.md.
#
# Note o caminho `/ws`: a raiz não aceita upgrade.
OPENCLAW_GATEWAY_URL=wss://openclaw.edsonbarrosojr.com.br/ws
# Token compartilhado do gateway. Necessário no PRIMEIRO pareamento; depois dele,
# o OPENCLAW_DEVICE_TOKEN basta.
OPENCLAW_GATEWAY_TOKEN=
# Emitido pelo gateway quando o dispositivo é aprovado: npm run parear-openclaw
OPENCLAW_DEVICE_TOKEN=
# Chave privada Ed25519 do dispositivo, em PEM ou base64. Use SÓ em ambiente sem
# disco gravável (Vercel): fora dele, o arquivo abaixo é o caminho normal.
# Quem tem esta chave fala pelo crmclinica com o orquestrador.
OPENCLAW_DEVICE_PRIVATE_KEY=
# Onde a identidade do dispositivo é guardada. O .gitignore cobre o padrão.
OPENCLAW_DEVICE_IDENTITY_PATH=
# Canal de saída dos lembretes e conta, quando o canal tem mais de uma.
OPENCLAW_CANAL=whatsapp
OPENCLAW_ACCOUNT_ID=
OPENCLAW_GATEWAY_TIMEOUT_MS=20000
# Segredo HMAC dos webhooks recebidos. Mínimo de 32 caracteres, obrigatório em produção.
OPENCLAW_WEBHOOK_SECRET=
OPENCLAW_TIMEOUT_MS=10000

# --- OpenClaw: gateway da instância da clínica (o WhatsApp dos pacientes) ---
# Outro processo, outro token, outro telefone. O de cima é o gateway de comando;
# este é por onde os pacientes falam com a Serena, e é o que o painel consulta
# para dizer qual linha está conectada.
#
# Vazio desliga a funcionalidade sem quebrar nada: o cartão "WhatsApp da clínica"
# aparece dizendo que não está configurado, em vez de falhar quando alguém clica.
OPENCLAW_CLINICA_GATEWAY_URL=
OPENCLAW_CLINICA_GATEWAY_TOKEN=
OPENCLAW_CLINICA_DEVICE_TOKEN=
# Identidade PRÓPRIA, sem herdar a do gateway de comando. Não é burocracia:
# administrar canal exige `operator.admin`, e aprovar esse pareamento na mesma
# identidade daria poder de trocar o telefone da clínica ao worker de lembretes,
# que roda sozinho a noite inteira. São dois dispositivos.
OPENCLAW_CLINICA_DEVICE_PRIVATE_KEY=
OPENCLAW_CLINICA_DEVICE_IDENTITY_PATH=
OPENCLAW_CLINICA_GATEWAY_TIMEOUT_MS=30000

# Endereço de administração do servidor do OpenClaw (usuario@host), para a
# instrução de vinculação manual do WhatsApp. Fica fora do bundle público de
# propósito: o app.js é servido sem login, e a API só devolve isto ao master.
OPENCLAW_SSH_HOST=

# --- Autenticação da equipe ---
# Chave HMAC dos access tokens. Mínimo de 32 caracteres, obrigatório em produção.
# Gere com: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
CRMCLINICA_JWT_SECRET=
# Endereço público, usado nos links de recuperação enviados por e-mail.
CRMCLINICA_URL_PUBLICA=http://127.0.0.1:4100
# Proxies cujo X-Forwarded-For é aceito, separados por vírgula. Aceita IP ou CIDR.
# Vazio por padrão: confiar no cabeçalho de qualquer origem permitiria forjar o
# IP e burlar o limite de tentativas. Preencha só com o IP do seu proxy reverso.
CRMCLINICA_PROXIES_CONFIAVEIS=

# --- Admin master ---
# Conta única que libera todas as outras. A senha inicial só serve para criar a
# conta: a troca é obrigatória no primeiro acesso.
# Crie ou atualize com: npm run criar-admin
CRMCLINICA_MASTER_EMAIL=
CRMCLINICA_MASTER_SENHA=
CRMCLINICA_MASTER_NOME=

# --- Login com conta Google (opcional) ---
# As três variáveis funcionam juntas ou nenhuma. Registre em console.cloud.google.com.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://127.0.0.1:4100/api/auth/google/retorno

# --- E-mail (recuperação de senha) ---
# Sem isto configurado, o pedido de recuperação é registrado em log e não sai.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# --- Lembretes de agendamento (24h e 2h) ---
# A fila é persistente e roda por um worker: npm run lembretes:worker
# Detalhes e operação em docs/LEMBRETES.md.
#
# `nao` desliga o enfileiramento sem mexer no que já está na fila.
LEMBRETES_ATIVOS=sim
# `real` envia de verdade pelo gateway do OpenClaw; `dry_run` roda a fila inteira
# sem mandar nada — o modo certo para desenvolver e testar mudanças na régua.
# Pedir `real` sem gateway configurado NÃO degrada em silêncio: o adaptador
# recusa, porque o alternativo seria a clínica achar que está lembrando alguém.
LEMBRETES_MODO_ENTREGA=dry_run
# Nome que aparece no texto enviado ao paciente.
CRMCLINICA_NOME_CLINICA=Clínica Dr. Edson Barroso
# Intervalo entre lotes do worker e quantos lembretes por lote.
LEMBRETES_INTERVALO_MS=60000
LEMBRETES_LOTE=20
# Tentativas antes de o lembrete ir para "falhou". O backoff dobra a cada uma.
LEMBRETES_MAX_TENTATIVAS=5

# --- Serena: agente de atendimento e barreiras clínicas ---
SERENA_BASE_URL=http://127.0.0.1:4101
SERENA_TOKEN=
# Dono da resposta no WhatsApp:
#   openclaw_gerencia — agente do canal responde diretamente (modo anterior)
#   crm_despacha      — Arquitetura B: CRM aplica as barreiras, chama a sessão
#                       interna e envia pelo canal. Só habilite em ensaio após
#                       configurar os dois gateways e OPENCLAW_SESSION_ID.
SERENA_TRANSPORTE_WHATSAPP=openclaw_gerencia

# --- Serena Voz: laboratório interno, livre e desligado por padrão ---
# O gateway Python roda fora da Vercel. Veja docs/SERENA_VOZ.md.
SERENA_VOZ_ATIVA=nao
SERENA_VOZ_GATEWAY_URL=
SERENA_VOZ_JWT_SECRET=
SERENA_VOZ_WEBHOOK_SECRET=
SERENA_VOZ_TOKEN_TTL_SEGUNDOS=
SERENA_VOZ_DURACAO_MAX_SEGUNDOS=900
SERENA_VOZ_PERFIL=local-livre
SERENA_VOZ_VOZ=serena

# --- Canais ---
WHATSAPP_WEBHOOK_SECRET=
WHATSAPP_BUSINESS_PHONE=5516993120938

# --- Provedor de modelo (opcional) ---
# O sistema funciona sem nada aqui. O provedor nunca controla o fluxo de atendimento.
KIMI_API_KEY=
KIMI_BASE_URL=https://api.moonshot.cn/v1
KIMI_MODEL=kimi-latest

# Espelho da agenda no Google Calendar do médico. A agenda do crmclinica continua
# sendo a fonte de verdade: é ela que impede dois pacientes no mesmo horário.
# O Google serve para o dia aparecer no celular, sem abrir o painel.
#
# CREDENCIAL: o JSON inteiro da conta de serviço, numa linha só.
# USUARIO: o e-mail do calendário a espelhar (delegação em todo o domínio).
GOOGLE_AGENDA_CREDENCIAL=
GOOGLE_AGENDA_USUARIO=
GOOGLE_AGENDA_CALENDARIO=primary

# Token da API que a Serena usa para operar o CRM. Próprio, nunca o da aplicação.
CRMCLINICA_AGENTE_TOKEN=

# Resumo do atendimento enviado à equipe quando a conversa esfria.
# Telefones separados por vírgula, em E.164.
CRMCLINICA_RESUMO_DESTINATARIOS=
CRMCLINICA_RESUMO_SILENCIO_MIN=30
